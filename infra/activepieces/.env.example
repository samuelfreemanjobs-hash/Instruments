# Copy to .env and fill secrets (never commit .env)
# Generate keys: openssl rand -hex 16  (repeat for each secret)

AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js

AP_API_KEY=
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=

AP_ENVIRONMENT=prod
AP_FRONTEND_URL=http://localhost:8080
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5

AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=change_me_strong_password

AP_EXECUTION_MODE=UNSANDBOXED
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
AP_FLOW_TIMEOUT_SECONDS=600
AP_TELEMETRY_ENABLED=false
AP_TEMPLATES_SOURCE_URL=https://cloud.activepieces.com/api/v1/flow-templates

AP_TOOL_SEARCH_ENABLED=false

# --- Disklordz automation (automate.sh / provision_disklordz_activepieces.py) ---
DISKLORDZ_AP_ADMIN_EMAIL=
DISKLORDZ_AP_ADMIN_PASSWORD=
DISKLORDZ_AP_ADMIN_FIRST_NAME=Disklordz
DISKLORDZ_AP_ADMIN_LAST_NAME=Studio
# Optional: Slack incoming webhook embedded in provisioned flow
DISKLORDZ_SLACK_WEBHOOK=
