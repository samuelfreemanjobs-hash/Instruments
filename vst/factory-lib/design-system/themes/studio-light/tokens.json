{
  "id": "studio-light",
  "name": "Studio Light (example)",
  "brandName": "Example Co.",
  "version": "0.1.0",
  "contract": "1.0.0",
  "color": {
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FBF8F2",
      "100": "#F3EFE6",
      "150": "#E9E4D8",
      "200": "#DCD5C5",
      "300": "#C4BBA8",
      "400": "#9A9282",
      "500": "#857D6F",
      "600": "#5E584E",
      "700": "#45403A",
      "800": "#2E2A26",
      "900": "#1E1C19"
    },
    "brand": {
      "subtle": "#F6E1D6",
      "fill": "#B4461A",
      "pressed": "#8A3412"
    },
    "accent": {
      "subtle": "#DDEFDD",
      "default": "#2E7D32",
      "hover": "#388E3C",
      "pressed": "#1B5E20"
    },
    "focus": {
      "ring": "#1F5FBF"
    },
    "premium": {
      "500": "#B8892E"
    },
    "meter": {
      "track": "#1E1C19",
      "rms": "#8F6B24",
      "peak": "#FFD24D",
      "hot": "#F07A2A",
      "over": "#FF4D4D"
    },
    "signal": {
      "amber": "#B36B00",
      "red": "#C62828"
    }
  },
  "semantic": {
    "bg": {
      "chassis": "{color.neutral.150}",
      "panel": "{color.neutral.100}",
      "section": "{color.neutral.50}",
      "well": "{color.neutral.200}",
      "overlay": "{color.neutral.0}"
    },
    "border": {
      "divider": "{color.neutral.300}",
      "subtle": "{color.neutral.200}",
      "overlay": "{color.neutral.300}"
    },
    "text": {
      "primary": "{color.neutral.900}",
      "secondary": "{color.neutral.700}",
      "tertiary": "{color.neutral.600}",
      "disabled": "{color.neutral.500}",
      "onBrand": "{color.neutral.0}",
      "onActive": "{color.neutral.0}",
      "onPremium": "{color.neutral.900}"
    },
    "control": {
      "body": "{color.neutral.50}",
      "bodyTop": "{color.neutral.0}",
      "rim": "{color.neutral.300}",
      "track": "{color.neutral.200}",
      "pointer": "{color.neutral.900}"
    },
    "brand": {
      "fill": "{color.brand.fill}",
      "stroke": "{color.brand.fill}",
      "pressed": "{color.brand.pressed}",
      "subtle": "{color.brand.subtle}"
    },
    "active": {
      "default": "{color.accent.default}",
      "hover": "{color.accent.hover}",
      "pressed": "{color.accent.pressed}",
      "subtle": "{color.accent.subtle}"
    },
    "focus": {
      "ring": "{color.focus.ring}"
    },
    "state": {
      "ledOff": "{color.neutral.200}",
      "caution": "{color.signal.amber}",
      "danger": "{color.signal.red}"
    },
    "premium": {
      "badge": "{color.premium.500}"
    },
    "meter": {
      "track": "{color.meter.track}",
      "rms": "{color.meter.rms}",
      "peak": "{color.meter.peak}",
      "hot": "{color.meter.hot}",
      "over": "{color.meter.over}",
      "hold": "{color.neutral.0}",
      "tick": "{color.neutral.600}",
      "tickLabel": "{color.neutral.600}"
    }
  },
  "usageRestrictions": [
    {
      "primitive": "color.meter",
      "allowedUnder": [
        "semantic.meter"
      ],
      "reason": "Meter colours only on level displays."
    },
    {
      "primitive": "color.premium",
      "allowedUnder": [
        "semantic.premium"
      ],
      "reason": "Premium colour only on premium badges."
    },
    {
      "primitive": "color.signal",
      "allowedUnder": [
        "semantic.meter",
        "semantic.state"
      ],
      "reason": "Signal colours carry meaning; never decorative."
    }
  ],
  "typography": {
    "family": {
      "sans": {
        "name": "IBM Plex Sans",
        "license": "OFL-1.1",
        "fallback": "system-ui"
      },
      "mono": {
        "name": "IBM Plex Mono",
        "license": "OFL-1.1",
        "fallback": "ui-monospace"
      }
    },
    "minSize": 10,
    "style": {
      "productName": {
        "family": "sans",
        "size": 20,
        "lineHeight": 24,
        "weight": 600,
        "tracking": 0.02,
        "case": "as-is"
      },
      "sectionTitle": {
        "family": "sans",
        "size": 12,
        "lineHeight": 16,
        "weight": 600,
        "tracking": 0.08,
        "case": "upper"
      },
      "legend": {
        "family": "sans",
        "size": 11,
        "lineHeight": 14,
        "weight": 600,
        "tracking": 0.06,
        "case": "upper"
      },
      "body": {
        "family": "sans",
        "size": 12,
        "lineHeight": 16,
        "weight": 400,
        "tracking": 0.0,
        "case": "sentence"
      },
      "value": {
        "family": "mono",
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "tracking": 0.0,
        "case": "as-is"
      },
      "valueLarge": {
        "family": "mono",
        "size": 16,
        "lineHeight": 20,
        "weight": 500,
        "tracking": 0.0,
        "case": "as-is"
      },
      "scale": {
        "family": "mono",
        "size": 10,
        "lineHeight": 12,
        "weight": 500,
        "tracking": 0.0,
        "case": "as-is"
      },
      "micro": {
        "family": "sans",
        "size": 10,
        "lineHeight": 12,
        "weight": 600,
        "tracking": 0.06,
        "case": "upper"
      }
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "none": 0,
    "xs": 3,
    "sm": 4,
    "md": 8,
    "pill": 999
  },
  "stroke": {
    "hairline": 1,
    "rim": 1.5,
    "arcSm": 2,
    "arcMd": 3,
    "arcLg": 4,
    "focus": 2,
    "focusOffset": 2
  },
  "elevation": {
    "lightSource": "top",
    "well": {
      "innerShadow": {
        "color": "#5E584E",
        "alpha": 0.25,
        "offsetY": 1,
        "blur": 2
      },
      "bottomHighlight": {
        "color": "#FFFFFF",
        "alpha": 0.6,
        "offsetY": -1,
        "blur": 0
      }
    },
    "flat": {},
    "raised": {
      "topHighlight": {
        "color": "#FFFFFF",
        "alpha": 0.8,
        "offsetY": 1,
        "blur": 0
      },
      "dropShadow": {
        "color": "#45403A",
        "alpha": 0.22,
        "offsetY": 2,
        "blur": 3
      },
      "bodyGradient": {
        "from": "semantic.control.bodyTop",
        "to": "semantic.control.body",
        "direction": "top-to-bottom"
      }
    },
    "overlay": {
      "dropShadow": {
        "color": "#45403A",
        "alpha": 0.2,
        "offsetY": 6,
        "blur": 12
      }
    }
  },
  "motion": {
    "hoverMs": 80,
    "pressMs": 60,
    "toggleMs": 120,
    "menuMs": 120,
    "tooltipDelayMs": 600,
    "tooltipFadeMs": 100,
    "meterRefreshHz": 30,
    "easing": "easeOutCubic",
    "reducedMotion": "all UI transitions 0 ms; meters keep their ballistics"
  },
  "size": {
    "hitTargetMin": 24,
    "windowPadding": 16,
    "headerHeight": 40,
    "legendGap": 4,
    "led": 6,
    "tooltipMaxWidth": 240,
    "knob": {
      "sm": 28,
      "md": 44,
      "lg": 60,
      "xl": 84
    },
    "knobArcInset": 4,
    "meterBar": {
      "sm": 6,
      "md": 12,
      "lg": 24,
      "xl": 36
    },
    "button": {
      "sm": 24,
      "md": 28,
      "lg": 32
    },
    "toggle": {
      "md": 24,
      "lg": 28
    },
    "slider": {
      "trackThickness": 4,
      "thumbLength": 20,
      "thumbThickness": 12
    },
    "scaleSteps": [
      0.75,
      1.0,
      1.25,
      1.5,
      2.0
    ]
  },
  "interaction": {
    "dragPixelsFullRange": 200,
    "fineModifierScale": 0.1,
    "wheelStepFraction": 0.01,
    "keyStepFraction": 0.01,
    "keyPageStepFraction": 0.1,
    "doubleClick": "reset to default",
    "valueEdit": "click readout to type a value; Enter commits, Esc cancels"
  },
  "meter": {
    "scale": "linear-db",
    "defaultFloorDb": -60,
    "numericFloorDb": -96,
    "hotThresholdDb": -6,
    "overThresholdDb": 0,
    "ticksDb": [
      0,
      -3,
      -6,
      -12,
      -18,
      -24,
      -36,
      -48,
      -60
    ],
    "labelledTicksDb": [
      0,
      -6,
      -12,
      -24,
      -36,
      -48,
      -60
    ],
    "peakWidthFraction": 0.5,
    "holdLineThickness": 2,
    "overCapHeight": 6
  },
  "contrast": [],
  "previewProduct": "Tape Echo"
}
