{
  "name": "DiskLordz Audio Design System",
  "version": "0.1.0",
  "brandSource": "docs/DISKLORDZ_BRAND_IDENTITY.md",

  "color": {
    "neutral": {
      "1000": "#050506",
      "950": "#0A0A0C",
      "900": "#111216",
      "850": "#16181D",
      "800": "#1C1F25",
      "750": "#23272E",
      "700": "#2C313A",
      "600": "#3B414C",
      "500": "#59606C",
      "400": "#7D8591",
      "300": "#A4ABB6",
      "200": "#C8CDD5",
      "100": "#E8EBEF",
      "0": "#FFFFFF"
    },
    "purple": {
      "900": "#241038",
      "700": "#4E1C7A",
      "600": "#7B2CBF",
      "400": "#A66AE6",
      "300": "#C49BF0"
    },
    "lime": {
      "900": "#2A3300",
      "700": "#7A9900",
      "500": "#CDFF00",
      "300": "#E1FF66"
    },
    "gold": {
      "500": "#C5A059"
    },
    "cyan": {
      "700": "#1F6B7D",
      "400": "#6FD3E8"
    },
    "signal": {
      "amber": "#F0A830",
      "red": "#F0484A"
    }
  },

  "semantic": {
    "bg": {
      "chassis": "{color.neutral.950}",
      "panel": "{color.neutral.900}",
      "section": "{color.neutral.850}",
      "well": "{color.neutral.1000}",
      "overlay": "{color.neutral.850}"
    },
    "border": {
      "divider": "{color.neutral.600}",
      "subtle": "{color.neutral.700}",
      "overlay": "{color.neutral.600}"
    },
    "text": {
      "primary": "{color.neutral.100}",
      "secondary": "{color.neutral.300}",
      "tertiary": "{color.neutral.400}",
      "disabled": "{color.neutral.500}",
      "onBrand": "{color.neutral.0}",
      "onActive": "{color.neutral.950}",
      "onPremium": "{color.neutral.950}"
    },
    "control": {
      "body": "{color.neutral.800}",
      "bodyTop": "{color.neutral.750}",
      "rim": "{color.neutral.700}",
      "track": "{color.neutral.700}",
      "pointer": "{color.neutral.100}"
    },
    "brand": {
      "fill": "{color.purple.600}",
      "stroke": "{color.purple.400}",
      "pressed": "{color.purple.700}",
      "subtle": "{color.purple.900}"
    },
    "active": {
      "default": "{color.lime.500}",
      "hover": "{color.lime.300}",
      "pressed": "{color.lime.700}",
      "subtle": "{color.lime.900}"
    },
    "focus": {
      "ring": "{color.purple.300}"
    },
    "state": {
      "ledOff": "{color.neutral.600}",
      "caution": "{color.signal.amber}",
      "danger": "{color.signal.red}"
    },
    "premium": {
      "badge": "{color.gold.500}"
    },
    "meter": {
      "track": "{color.neutral.1000}",
      "rms": "{color.cyan.700}",
      "peak": "{color.cyan.400}",
      "hot": "{color.signal.amber}",
      "over": "{color.signal.red}",
      "hold": "{color.neutral.0}",
      "tick": "{color.neutral.600}",
      "tickLabel": "{color.neutral.400}"
    }
  },

  "usageRestrictions": [
    {
      "primitive": "color.cyan",
      "allowedUnder": ["semantic.meter"],
      "reason": "Steel cyan is reserved for audio level displays (operator decision, design system v0.1)."
    },
    {
      "primitive": "color.gold",
      "allowedUnder": ["semantic.premium"],
      "reason": "Brand v1: metallic gold for crowns / premium badges only."
    },
    {
      "primitive": "color.signal",
      "allowedUnder": ["semantic.meter", "semantic.state"],
      "reason": "Amber and red carry meaning (hot / over / caution / danger); never decorative."
    }
  ],

  "contrast": [
    { "fg": "semantic.text.primary", "bg": "semantic.bg.panel", "min": 7.0, "use": "legends, values on panels" },
    { "fg": "semantic.text.primary", "bg": "semantic.bg.section", "min": 7.0, "use": "legends, values in sections" },
    { "fg": "semantic.text.primary", "bg": "semantic.bg.well", "min": 7.0, "use": "readouts in display wells" },
    { "fg": "semantic.text.secondary", "bg": "semantic.bg.panel", "min": 4.5, "use": "units, idle values" },
    { "fg": "semantic.text.secondary", "bg": "semantic.bg.section", "min": 4.5, "use": "units, idle values" },
    { "fg": "semantic.text.tertiary", "bg": "semantic.bg.panel", "min": 4.5, "use": "scale labels (10 px)" },
    { "fg": "semantic.text.tertiary", "bg": "semantic.bg.well", "min": 4.5, "use": "meter tick labels" },
    { "fg": "semantic.text.disabled", "bg": "semantic.bg.panel", "min": 2.5, "use": "disabled text (WCAG-exempt, still legible)" },
    { "fg": "semantic.text.onBrand", "bg": "semantic.brand.fill", "min": 4.5, "use": "text on purple fills" },
    { "fg": "semantic.text.onActive", "bg": "semantic.active.default", "min": 7.0, "use": "text on lime buttons" },
    { "fg": "semantic.text.onPremium", "bg": "semantic.premium.badge", "min": 4.5, "use": "badge text" },
    { "fg": "semantic.brand.stroke", "bg": "semantic.control.track", "min": 3.0, "use": "knob value arc vs track" },
    { "fg": "semantic.brand.stroke", "bg": "semantic.bg.panel", "min": 3.0, "use": "purple strokes on panels" },
    { "fg": "semantic.focus.ring", "bg": "semantic.bg.panel", "min": 3.0, "use": "keyboard focus ring" },
    { "fg": "semantic.focus.ring", "bg": "semantic.bg.section", "min": 3.0, "use": "keyboard focus ring" },
    { "fg": "semantic.active.default", "bg": "semantic.state.ledOff", "min": 3.0, "use": "LED on vs off" },
    { "fg": "semantic.active.default", "bg": "semantic.bg.panel", "min": 3.0, "use": "lime indicators on panels" },
    { "fg": "semantic.control.pointer", "bg": "semantic.control.body", "min": 4.5, "use": "knob pointer line" },
    { "fg": "semantic.meter.rms", "bg": "semantic.meter.track", "min": 3.0, "use": "RMS fill vs empty meter" },
    { "fg": "semantic.meter.peak", "bg": "semantic.meter.rms", "min": 3.0, "use": "peak bar distinguishable over RMS" },
    { "fg": "semantic.meter.hot", "bg": "semantic.meter.track", "min": 3.0, "use": "hot zone" },
    { "fg": "semantic.meter.over", "bg": "semantic.meter.track", "min": 3.0, "use": "over cap" },
    { "fg": "semantic.meter.hold", "bg": "semantic.meter.peak", "min": 1.4, "use": "hold line over peak (also differs by shape)" },
    { "fg": "semantic.state.caution", "bg": "semantic.bg.panel", "min": 3.0, "use": "bypass / caution LED" },
    { "fg": "semantic.state.danger", "bg": "semantic.bg.panel", "min": 3.0, "use": "error / over indicators" }
  ],

  "typography": {
    "family": {
      "sans": { "name": "Inter", "license": "OFL-1.1", "fallback": "system-ui" },
      "mono": { "name": "JetBrains Mono", "license": "OFL-1.1", "fallback": "ui-monospace" }
    },
    "minSize": 10,
    "style": {
      "productName":  { "family": "sans", "size": 18, "lineHeight": 22, "weight": 700, "tracking": 0.06, "case": "upper" },
      "sectionTitle": { "family": "sans", "size": 12, "lineHeight": 16, "weight": 600, "tracking": 0.08, "case": "upper" },
      "legend":       { "family": "sans", "size": 11, "lineHeight": 14, "weight": 600, "tracking": 0.08, "case": "upper" },
      "body":         { "family": "sans", "size": 12, "lineHeight": 16, "weight": 400, "tracking": 0.0,  "case": "sentence" },
      "value":        { "family": "mono", "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.0,  "case": "as-is" },
      "valueLarge":   { "family": "mono", "size": 16, "lineHeight": 20, "weight": 500, "tracking": 0.0,  "case": "as-is" },
      "scale":        { "family": "mono", "size": 10, "lineHeight": 12, "weight": 500, "tracking": 0.0,  "case": "as-is" },
      "micro":        { "family": "sans", "size": 10, "lineHeight": 12, "weight": 600, "tracking": 0.06, "case": "upper" }
    }
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },

  "radius": { "none": 0, "xs": 2, "sm": 3, "md": 4, "pill": 999 },

  "stroke": { "hairline": 1, "rim": 1.5, "arcSm": 2, "arcMd": 3, "arcLg": 4, "focus": 2, "focusOffset": 2 },

  "elevation": {
    "lightSource": "top",
    "well": {
      "innerShadow": { "color": "#000000", "alpha": 0.7, "offsetY": 1, "blur": 2 },
      "bottomHighlight": { "color": "#FFFFFF", "alpha": 0.05, "offsetY": -1, "blur": 0 }
    },
    "flat": {},
    "raised": {
      "topHighlight": { "color": "#FFFFFF", "alpha": 0.07, "offsetY": 1, "blur": 0 },
      "dropShadow": { "color": "#000000", "alpha": 0.55, "offsetY": 2, "blur": 4 },
      "bodyGradient": { "from": "semantic.control.bodyTop", "to": "semantic.control.body", "direction": "top-to-bottom" }
    },
    "overlay": {
      "dropShadow": { "color": "#000000", "alpha": 0.6, "offsetY": 6, "blur": 16 }
    }
  },

  "motion": {
    "hoverMs": 80,
    "pressMs": 60,
    "toggleMs": 120,
    "menuMs": 120,
    "tooltipDelayMs": 600,
    "tooltipFadeMs": 100,
    "meterRefreshHz": 30,
    "easing": "easeOutCubic",
    "reducedMotion": "all UI transitions 0 ms; meters keep their ballistics"
  },

  "size": {
    "hitTargetMin": 24,
    "windowPadding": 16,
    "headerHeight": 40,
    "legendGap": 4,
    "led": 6,
    "tooltipMaxWidth": 240,
    "knob": { "sm": 28, "md": 44, "lg": 60, "xl": 84 },
    "knobArcInset": 4,
    "meterBar": { "sm": 6, "md": 12, "lg": 24, "xl": 36 },
    "button": { "sm": 24, "md": 28, "lg": 32 },
    "toggle": { "md": 24, "lg": 28 },
    "slider": { "trackThickness": 4, "thumbLength": 20, "thumbThickness": 12 },
    "scaleSteps": [0.75, 1.0, 1.25, 1.5, 2.0]
  },

  "interaction": {
    "dragPixelsFullRange": 200,
    "fineModifierScale": 0.1,
    "wheelStepFraction": 0.01,
    "keyStepFraction": 0.01,
    "keyPageStepFraction": 0.1,
    "doubleClick": "reset to default",
    "valueEdit": "click readout to type a value; Enter commits, Esc cancels"
  },

  "meter": {
    "scale": "linear-db",
    "defaultFloorDb": -60,
    "numericFloorDb": -96,
    "hotThresholdDb": -6,
    "overThresholdDb": 0,
    "ticksDb": [0, -3, -6, -12, -18, -24, -36, -48, -60],
    "labelledTicksDb": [0, -6, -12, -24, -36, -48, -60],
    "peakWidthFraction": 0.5,
    "holdLineThickness": 2,
    "overCapHeight": 6
  }
}
