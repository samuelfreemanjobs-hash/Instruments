{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disklordz.local/schemas/asset.json",
  "title": "CatalogAsset",
  "type": "object",
  "required": ["asset_id", "kind", "title", "rights_status"],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^DL-(TRK|DRM|808|LOP|PRS|FX|VIS|VID|MID|KIT)-[0-9]{6}$",
      "description": "e.g. DL-TRK-000001"
    },
    "kind": {
      "type": "string",
      "enum": [
        "track",
        "drum",
        "808",
        "loop",
        "preset",
        "fx",
        "visual",
        "video",
        "midi",
        "kit"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "artist_id": { "type": "string", "pattern": "^DL[0-9]{3}$" },
    "project_id": { "type": "string" },
    "genre": { "type": "string" },
    "subgenre": { "type": "string" },
    "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
    "musical_key": { "type": "string" },
    "mood": { "type": "array", "items": { "type": "string" } },
    "source_track_id": { "type": "string" },
    "file_path": { "type": "string" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "rights_status": {
      "type": "string",
      "enum": ["draft", "review", "cleared", "blocked"]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "samples": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "youtube_url": { "type": "string", "format": "uri" },
    "streaming_url": { "type": "string", "format": "uri" },
    "product_sku": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
