{
  "format": "instruments-autosampler-mega-bank-v2",
  "name": "OvernightTwentySixSynthBank",
  "capture": {
    "lowNote": 36,
    "highNote": 96,
    "noteStep": 3,
    "noteMapPreset": "minorThird",
    "blackKeyPolicy": "skip",
    "recordUntilSilence": true,
    "maxRecordSeconds": 25,
    "gapMs": 150,
    "recordVelocity": 100,
    "multiVelocityLayers": true,
    "velocityLayers": [32, 64, 96, 127],
    "trimSilence": true,
    "normalize": true,
    "sustainLoop": true,
    "trimThresholdDb": -48.0,
    "normalizePeakDb": -0.3,
    "minLoopConfidence": 0.35,
    "noteOffAtRatio": 0.82,
    "silenceThresholdDb": -52.0,
    "silenceHoldSeconds": 0.3
  },
  "run": {
    "failFast": true,
    "skipFailedSources": true,
    "resume": true,
    "writeProgress": true,
    "maxRetriesPerSource": 0,
    "sourceTimeoutSeconds": 3600,
    "pluginCacheFile": ""
  },
  "sources": [
    {
      "presetName": "Synth_01",
      "vst3Path": "/path/to/Synth1.vst3",
      "programIndex": 0
    },
    {
      "presetName": "Synth_02",
      "vst3Path": "/path/to/Synth2.vst3",
      "programIndex": 0,
      "lowNote": 48,
      "highNote": 84,
      "noteStep": 4
    }
  ]
}
