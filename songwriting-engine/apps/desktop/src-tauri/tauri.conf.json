{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antigravity Songwriting Engine",
  "version": "0.1.0",
  "identifier": "com.noizefield.antigravitysongwriting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Antigravity Songwriting Engine",
        "width": 1360,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/songwriting-engine.exe": "songwriting-engine.exe"
    }
  }
}
