{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "factory-linux-release",
      "displayName": "Linux Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "factory-windows-vs",
      "displayName": "Windows VS2022 Release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "factory-linux-release",
      "configurePreset": "factory-linux-release"
    },
    {
      "name": "factory-windows-vs",
      "configurePreset": "factory-windows-vs",
      "configuration": "Release"
    }
  ]
}
