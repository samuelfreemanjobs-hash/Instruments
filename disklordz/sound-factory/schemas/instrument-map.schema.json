{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disklordz.local/schemas/instrument-map.json",
  "title": "InstrumentMapSpec",
  "type": "object",
  "required": ["format", "version", "instrumentId", "sampleRate", "zones"],
  "properties": {
    "format": { "const": "DISKLORDZ_INSTRUMENT_MAP" },
    "version": { "const": 1 },
    "instrumentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string" },
    "productId": { "type": "string" },
    "sampleRate": { "const": 44100 },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["samplePath", "rootKey", "loKey", "hiKey", "loVel", "hiVel"],
        "properties": {
          "samplePath": { "type": "string" },
          "rootKey": { "type": "integer", "minimum": 0, "maximum": 127 },
          "loKey": { "type": "integer", "minimum": 0, "maximum": 127 },
          "hiKey": { "type": "integer", "minimum": 0, "maximum": 127 },
          "loVel": { "type": "integer", "minimum": 0, "maximum": 127 },
          "hiVel": { "type": "integer", "minimum": 0, "maximum": 127 },
          "tuneCents": { "type": "number" },
          "volumeDb": { "type": "number" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
