{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSP signal-flow graph v1",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "enum": ["oscillator", "filter", "envelope", "lfo", "mixer", "delay", "reverb", "distortion", "output"]
          },
          "module_id": { "type": "string" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "port": { "type": "string", "default": "audio" }
        }
      }
    }
  }
}
