{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://disklordz.audio/schemas/factory-spec-v2.json",
  "title": "DiskLordz VST Factory project spec v2",
  "allOf": [{ "$ref": "factory-spec-v1.json" }],
  "type": "object",
  "properties": {
    "schema_version": { "const": "factory-spec/v2" },
    "product_category": {
      "type": "string",
      "description": "Taxonomy id e.g. synth.wavetable, fx.mastering, midi.chord_generator"
    },
    "formats": {
      "type": "object",
      "properties": {
        "vst3": { "type": "boolean", "default": true },
        "standalone": { "type": "boolean", "default": true },
        "au": { "type": "boolean", "default": false },
        "clap": { "type": "boolean", "default": false },
        "aax": { "type": "boolean", "default": false },
        "lv2": { "type": "boolean", "default": false }
      }
    },
    "commercial": {
      "type": "object",
      "properties": {
        "release_ready": { "type": "boolean", "default": false },
        "license_checklist_passed": { "type": "boolean", "default": false },
        "build_kind": { "type": "string", "enum": ["development", "release"], "default": "development" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": ["verified", "untested", "known_fail"]
        }
      }
    },
    "memory_refs": {
      "type": "object",
      "properties": {
        "company": { "type": "string", "default": "company" },
        "product_slug": { "type": "string" },
        "technical_tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
