# DiskLordz automation — copy to .env (do not commit)

# Create token: https://airtable.com/create/tokens
# Scopes: data.records:read/write, schema.bases:read/write
AIRTABLE_API_KEY=

# From base URL https://airtable.com/appXXXXXXXX/... or create_base_from_schema.py --write-env
AIRTABLE_BASE_ID=

# Optional table name overrides (defaults match base-schema.json)
AIRTABLE_TABLE_PRODUCTS=Products
AIRTABLE_TABLE_PROJECTS=Projects
AIRTABLE_TABLE_WORK_ORDERS=Agent Work Orders

GITHUB_TOKEN=
GITHUB_REPO=samuelfreemanjobs-hash/Instruments
