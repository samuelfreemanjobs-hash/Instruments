# Supabase (WO-SAAS-002) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required on Vercel for persistent kit WAVs (WO-SAAS-009)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Pro (WO-SAAS-010)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TRIPWIRE_PRICE_ID=

# Optional
SAAS_DAILY_GEN_LIMIT=20

# Memphis launch funnel (docs/DISKLORDZ_MASTER_LAUNCH_CANVAS.md)
LAUNCH_VOCAL_STEMS_URL=
LAUNCH_TRIPWIRE_CASSETTE_URL=
LAUNCH_TRIPWIRE_IR_URL=
LAUNCH_FLAGSHIP_URL=
LAUNCH_MEMPHIS_VAULT_URL=
# Optional Day-1 delivery via Resend (Loops.so can replace later)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Launch automation (FORGE / PM — set once)
LAUNCH_CAMPAIGN_START=
LAUNCH_PUBLIC_BASE_URL=
LAUNCH_TRIPWIRE_SAMPLE_URL=
LAUNCH_TRIPWIRE_ENABLED=
CRON_SECRET=
AUTOMATION_SECRET=
