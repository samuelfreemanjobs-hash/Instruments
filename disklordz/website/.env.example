# Supabase (WO-SAAS-002) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required on Vercel for persistent kit WAVs (WO-SAAS-009)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Pro (WO-SAAS-010)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional
SAAS_DAILY_GEN_LIMIT=20

# RAG pgvector + Vercel AI SDK (WO-SAAS-012b)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Inngest async generation (WO-SAAS-009)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Remote audio engines (disklordz/integrations/engines)
DISKLORDZ_ENGINE=parametric
DISKLORDZ_AUDIOCRAFT_ENGINE_URL=
DISKLORDZ_STABLE_AUDIO_ENGINE_URL=

# Phone PWA → /api/agent → Grok Bot / Cursor cloud (server-only; copy to Vercel + .env.local)
# Paste hook URL from Grok Bot inference / ACP or Cursor developer dashboard — NOT https://cursor.com root
GROK_INFERENCE_HOOK_URL=
CURSOR_AGENT_API_URL=
CURSOR_API_KEY=
GROK_SESSION_ID=
GROK_SIGNING_SECRET=
GROK_WEBHOOK_SECRET=
GROK_CALLBACK_PUBLIC_URL=
GROK_BOT_TOKEN=
GROK_DEFAULT_REPO_URL=https://github.com/samuelfreemanjobs-hash/Instruments
# Optional short AGENTS.md excerpt pasted for Grok context (else default hint in hook)
GROK_AGENTS_MD_EXCERPT=
