# Black Friday Madness — Next.js (copy to .env.local)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEAL_API_ORIGIN=http://127.0.0.1:3847

# After catalog sync + migration 006
NEXT_PUBLIC_USE_SUPABASE_CATALOG=1

# Same value as API VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Inngest (Vercel)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Admin console (must match signed-in Supabase user email)
BFM_ADMIN_EMAILS=

# Server-only on Vercel (never NEXT_PUBLIC)
BFM_ADMIN_SECRET=
N8N_WEBHOOK_SECRET=
