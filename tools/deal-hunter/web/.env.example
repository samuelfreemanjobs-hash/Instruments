# Black Friday Madness — Next.js (copy to .env.local)

# Local dev (optional). Published Cursor app uses bound secrets below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEAL_API_ORIGIN=http://127.0.0.1:3847

# Cursor Apps / server secrets (bind in publish dialog; not NEXT_PUBLIC_*)
SUPABASE_URL=
SUPABASE_ANON_KEY=
USE_SUPABASE_CATALOG=1
VAPID_PUBLIC_KEY=

# Inngest (Vercel)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Admin console (must match signed-in Supabase user email)
BFM_ADMIN_EMAILS=

# Server-only on Vercel (never NEXT_PUBLIC)
BFM_ADMIN_SECRET=
N8N_WEBHOOK_SECRET=
