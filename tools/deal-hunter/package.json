{
  "name": "deal-hunter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --prefix web",
    "dev:legacy": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc --noEmit",
    "build:web": "npm run build --prefix web",
    "export:hosted-catalog": "tsx scripts/export-hosted-catalog.ts",
    "slim:hosted-catalog": "tsx scripts/slim-hosted-catalog.ts",
    "build:legacy": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e --prefix web",
    "sync:supabase": "tsx scripts/sync-supabase-catalog.ts",
    "go-live": "bash scripts/bfm-go-live.sh all",
    "go-live:verify": "tsx scripts/verify-bfm-live.ts",
    "setup:env": "bash scripts/setup-web-env.sh",
    "supabase:migrate": "bash scripts/apply-supabase-migrations.sh",
    "provision:supabase": "bash scripts/provision-supabase.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "nanoid": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5",
    "workbox-window": "^7.3.0"
  }
}
