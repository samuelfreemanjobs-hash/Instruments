# Express deal API
PORT=3847
DEAL_HUNTER_DB=./data/deal-hunter.sqlite
N8N_WEBHOOK_URL=

# Next.js (copy to web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEAL_API_ORIGIN=http://127.0.0.1:3847

# Server-only (Supabase sync jobs — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SYNC_CATALOG_SECRET=
USE_SUPABASE_CATALOG=1
CATALOG_SYNC_INTERVAL_MINUTES=60

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Next.js web public key (same as VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_USE_SUPABASE_CATALOG=1

# Inngest (Next app on Vercel)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Admin console (comma-separated emails + optional server secret)
BFM_ADMIN_EMAILS=
BFM_ADMIN_SECRET=

# n8n cron fallback (catalog sync + steal dispatch)
N8N_WEBHOOK_SECRET=
