{
  "name": "Savvy HQ — autopilot digest",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] }
      },
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SAVVY_HQ_API_URL}}/api/autopilot/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "x-n8n-secret", "value": "={{$env.N8N_WEBHOOK_SECRET}}" }]
        },
        "sendBody": true,
        "jsonParameters": true,
        "bodyParametersJson": "={\"profile\": {\"zip\": \"78701\", \"maxBudget\": 500}}"
      },
      "name": "Run autopilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.N8N_WEBHOOK_EMAIL_INTERNAL}}",
        "sendBody": true,
        "jsonParameters": true,
        "bodyParametersJson": "={\"subject\": \"Savvy HQ digest\", \"body\": $json.topVerdicts}"
      },
      "name": "Email digest (wire SendGrid)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Every 15 minutes": { "main": [[{ "node": "Run autopilot", "type": "main", "index": 0 }]] },
    "Run autopilot": { "main": [[{ "node": "Email digest (wire SendGrid)", "type": "main", "index": 0 }]] }
  }
}
