# LLM (optional — without keys the agent runs in stub/harness-only mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
AGENT_MODEL=gpt-4o-mini
AGENT_MAX_TURNS=12

# Repo root for tools (default: auto-detect monorepo root)
REPO_ROOT=

# Optional E2B cloud sandbox
E2B_API_KEY=

# Production CORS (comma-separated origins)
CORS_ORIGINS=http://127.0.0.1:8790,http://localhost:8790

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub webhook (future PR reviewer)
GITHUB_WEBHOOK_SECRET=

# Grok Bot (ACP ingress — your existing Grokbot channel)
GROK_WEBHOOK_URL=
GROK_BOT_TOKEN=
GROK_CHANNEL_ID=
GROK_WEBHOOK_SECRET=
# JSON map of routine_id → human label, e.g. {"fetch-api-keys":"Internal console routine"}
GROK_ROUTINES_JSON={}
AGENTS_PROFILE_REL=AGENTS.md
