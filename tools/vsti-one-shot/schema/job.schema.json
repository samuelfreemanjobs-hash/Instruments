{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruments.local/vsti-one-shot/job.schema.json",
  "title": "VstiOneShotRenderJob",
  "type": "object",
  "required": ["version", "output_dir", "defaults", "renders"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "style": { "type": "string" },
    "output_dir": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "required": ["sample_rate", "velocity", "channels", "normalize_peak_db", "tail_silence_db", "max_capture_sec"],
      "properties": {
        "sample_rate": { "type": "number", "minimum": 8000 },
        "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "channels": { "enum": ["mono", "stereo"] },
        "normalize_peak_db": { "type": "number", "maximum": 0 },
        "tail_silence_db": { "type": "number", "maximum": 0 },
        "max_capture_sec": { "type": "number", "minimum": 0.1 }
      }
    },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot_id", "vst3_path", "program", "root_midi"],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1 },
          "vst3_path": { "type": "string", "minLength": 1 },
          "program": { "type": "integer", "minimum": 0 },
          "root_midi": { "type": "integer", "minimum": 0, "maximum": 127 },
          "max_capture_sec": { "type": "number", "minimum": 0.1 }
        }
      }
    }
  }
}
