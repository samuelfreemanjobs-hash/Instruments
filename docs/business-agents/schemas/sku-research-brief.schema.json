{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruments.local/schemas/sku-research-brief.json",
  "title": "SKU research brief (Planner input)",
  "type": "object",
  "required": [
    "schema_version",
    "product_id",
    "sku_name",
    "lane",
    "research_question",
    "findings",
    "gaps_and_opportunities",
    "planner_recommendation",
    "information_gaps"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1" },
    "product_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sku_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "lane": {
      "enum": [
        "juce-factory",
        "content-vital",
        "disklordz",
        "tr808-pwa",
        "hise"
      ]
    },
    "research_question": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["finding", "confidence"],
        "properties": {
          "finding": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "supporting_data": { "type": "string" }
        }
      }
    },
    "market_size_and_growth": { "type": "object" },
    "key_players": { "type": "array" },
    "trends": { "type": "array", "items": { "type": "string" } },
    "gaps_and_opportunities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "information_gaps": { "type": "array", "items": { "type": "string" } },
    "planner_recommendation": {
      "type": "object",
      "required": ["decision", "rationale"],
      "properties": {
        "decision": { "enum": ["proceed", "defer", "kill", "needs_human"] },
        "rationale": { "type": "string" },
        "suggested_wo_title": { "type": "string" },
        "price_tier_notes": { "type": "string" }
      }
    },
    "recommended_next_research": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string" },
    "human_approved": { "type": "boolean" }
  }
}
